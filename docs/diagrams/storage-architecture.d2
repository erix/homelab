direction: down

title: K3s Homelab — Storage Backends {
  near: top-center
  shape: text
  style.font-size: 24
  style.bold: true
}

apps: Flux-Managed Workloads {
  style.fill: "#e3f2fd"
  style.stroke: "#1565c0"

  stateful: "Databases and app configuration"
  media: "Media libraries and downloads"
  hardware: "Hardware-bound workloads"
}

storage: Declared Storage Paths {
  style.fill: "#fafafa"
  style.stroke: "#424242"
  style.stroke-width: 3

  local: {
    label: "local-path\nNode-local persistent volumes"
    shape: cylinder
    style.fill: "#c8e6c9"
    style.stroke: "#2e7d32"
  }

  ssd: {
    label: "local-path-ssd\n/mnt/data/local-path\nWaitForFirstConsumer"
    shape: cylinder
    style.fill: "#a5d6a7"
    style.stroke: "#1b5e20"
  }

  nfs: {
    label: "Static NFS volumes\nTrueNAS media, downloads,\nbooks, Immich, meditations"
    shape: cylinder
    style.fill: "#d1c4e9"
    style.stroke: "#512da8"
  }

  existing: {
    label: "Pre-existing PVC references\nHome Assistant • MQTT • Zigbee2MQTT\nCalibre and Calibre-Web"
    shape: cylinder
    style.fill: "#fff9c4"
    style.stroke: "#f9a825"
  }

  host: {
    label: "hostPath / host devices\nTrading data • /dev/dri\n/dev/ttyUSB0 • /run/udev"
    shape: cylinder
    style.fill: "#ffcdd2"
    style.stroke: "#c62828"
  }
}

examples: Workload Examples {
  style.fill: "#fff3e0"
  style.stroke: "#ef6c00"

  local_apps: "local-path\nMariaDB • n8n • UniFi\nAIO addons • subscriptions\nIB Gateway • Calibre automation"
  ssd_apps: "local-path-ssd\nImmich app + DB • Plex config\nRDT database"
  nfs_apps: "NFS\nPlex media/downloads • RDT media/downloads\nImmich library • meditation library"
}

retained: Retained Infrastructure Configuration {
  style.fill: "#eceff1"
  style.stroke: "#546e7a"

  longhorn: "Longhorn values and storage classes\nretained under infrastructure/"
  note: "Active app manifests shown here do not\nselect a Longhorn storage class."
}

apps.stateful -> storage.local
apps.stateful -> storage.ssd
apps.stateful -> storage.existing
apps.media -> storage.nfs
apps.hardware -> storage.host

storage.local -> examples.local_apps
storage.ssd -> examples.ssd_apps
storage.nfs -> examples.nfs_apps

note: "StorageClass selection comes from workload manifests.\nVerify PV/PVC binding and node placement in the live cluster." {
  shape: text
  style.italic: true
  style.font-size: 12
}
