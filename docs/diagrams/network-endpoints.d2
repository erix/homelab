direction: down

title: K3s Homelab — Network Paths {
  near: top-center
  shape: text
  style.font-size: 24
  style.bold: true
}

clients: Clients {
  shape: cloud
  style.fill: "#e3f2fd"
  style.stroke: "#1565c0"
}

dns: "*.erix-homelab.site\nDNS + wildcard TLS" {
  shape: rectangle
  style.fill: "#fff9c4"
  style.stroke: "#f9a825"
}

traefik: "Traefik\nHTTP → HTTPS\nhost-based routing" {
  shape: hexagon
  style.fill: "#bbdefb"
  style.stroke: "#1565c0"
  style.stroke-width: 3
}

routes: Repository-declared Ingress Hosts {
  style.fill: "#e8f5e9"
  style.stroke: "#2e7d32"

  home: {
    label: "Home automation\nhass • ha-config • z2m"
    shape: rectangle
    style.fill: "#c8e6c9"
  }

  media: {
    label: "Media\ncalibre • books • books-automated\nrdt • plex • immich • meditations"
    shape: rectangle
    style.fill: "#c8e6c9"
  }

  stremio: {
    label: "Stremio addons\naiometadata • aiostreams"
    shape: rectangle
    style.fill: "#c8e6c9"
  }

  tools: {
    label: "Tools\nn8n • paste • trading • ibkr\nsubs • confidence • unifi"
    shape: rectangle
    style.fill: "#c8e6c9"
  }

  external_routes: {
    label: "External backends\npaperless • jackettio • minio\nkaiburg • openclaw • proxmox"
    shape: rectangle
    style.fill: "#c8e6c9"
  }
}

lb: Direct LoadBalancer Services {
  style.fill: "#fff3e0"
  style.stroke: "#e65100"

  fixed: {
    label: "Manifest-pinned addresses\n.203 MariaDB • .205 UniFi\n.208 Calibre • .211 Calibre-Web Automated\n.225 Mail Relay • .230 MQTT"
    shape: rectangle
    style.fill: "#ffcc80"
  }

  allocated: {
    label: "Pool-allocated addresses\nHome Assistant • Zigbee2MQTT • Calibre-Web\nIB Gateway • IBeam"
    shape: rectangle
    style.fill: "#ffe0b2"
  }
}

external: External LAN Backends {
  style.fill: "#f3e5f5"
  style.stroke: "#7b1fa2"

  truenas: "TrueNAS services\nPaperless • Jackettio • MinIO"
  kaiburg: "Kaiburg services\nKaiburg • OpenClaw"
  proxmox: "Proxmox API/UI"
}

clients -> dns: resolve
dns -> traefik: HTTPS
traefik -> routes.home
traefik -> routes.media
traefik -> routes.stremio
traefik -> routes.tools
traefik -> routes.external_routes
clients -> lb.fixed: LAN protocols
clients -> lb.allocated: LAN protocols
routes.external_routes -> external: Service + Endpoints

note: "Only explicit static IPs are shown.\nPool-allocated addresses must be read from the live cluster." {
  shape: text
  style.italic: true
  style.font-size: 12
}
