direction: down

title: Tailscale-Exposed Kubernetes Services {
  near: top-center
  shape: text
  style.font-size: 24
  style.bold: true
}

clients: Tailnet Clients {
  style.fill: "#e3f2fd"
  style.stroke: "#1565c0"

  laptop: Laptop
  phone: Phone
  automation: Remote automation
}

tailnet: "Tailscale Tailnet\nWireGuard-encrypted mesh" {
  shape: cloud
  style.fill: "#fce4ec"
  style.stroke: "#c2185b"
  style.stroke-width: 3
}

cluster: K3s Cluster {
  style.fill: "#e8f5e9"
  style.stroke: "#2e7d32"

  operator: "Tailscale Operator\nHelm-managed"

  annotated: Manifest-Annotated Services {
    style.fill: "#fff3e0"
    style.stroke: "#ef6c00"

    gateway: {
      label: "IB Gateway\n4001 paper API\n4002 live API • 5900 VNC"
      shape: rectangle
      style.fill: "#d1c4e9"
    }

    ibeam: {
      label: "IBeam\n5000 REST API"
      shape: rectangle
      style.fill: "#d1c4e9"
    }
  }

  lan: {
    label: "MetalLB / LAN access\nremains separate from Tailnet routing"
    shape: rectangle
    style.fill: "#c8e6c9"
  }
}

upstream: External APIs {
  style.fill: "#eceff1"
  style.stroke: "#546e7a"

  ibkr: "Interactive Brokers"
}

clients -> tailnet: authenticated access
tailnet -> cluster.operator: operator-managed proxy
cluster.operator -> cluster.annotated.gateway: tailscale.com/expose
cluster.operator -> cluster.annotated.ibeam: tailscale.com/expose
cluster.annotated.gateway -> upstream.ibkr
cluster.annotated.ibeam -> upstream.ibkr

note: "The repository currently annotates IB Gateway and IBeam.\nTailnet DNS names and live proxy status are operator-assigned." {
  shape: text
  style.italic: true
  style.font-size: 12
}
