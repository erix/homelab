direction: down

title: K3s Homelab — Declared Architecture {
  near: top-center
  shape: text
  style.font-size: 24
  style.bold: true
}

git: GitHub Repository {
  shape: cylinder
  style.fill: "#e3f2fd"
  style.stroke: "#1565c0"

  source: "main branch\nclusters/new/"
}

flux: Flux GitOps {
  style.fill: "#f3e5f5"
  style.stroke: "#7b1fa2"

  bootstrap: "GitRepository\nflux-system"
  apps: "Parent Kustomization\napps"
  workloads: "Per-workload\nKustomizations"
  automation: "Image policies and\nautomation"

  bootstrap -> apps
  apps -> workloads
  automation -> workloads: image overrides
}

external: External Git Sources {
  style.fill: "#fff8e1"
  style.stroke: "#ef6c00"

  movie_night: "Movie Night"
  splitbot: "Splitbot\n+ tunnel"
}

cluster: K3s Cluster {
  style.fill: "#fafafa"
  style.stroke: "#424242"
  style.stroke-width: 3

  platform: Cluster Platform {
    style.fill: "#fff9c4"
    style.stroke: "#f9a825"

    ingress: "Traefik\nIngress + TLS"
    network: "MetalLB\nLoadBalancer services"
    secrets: "Sealed Secrets\ncredential delivery"
    storage: "local-path / SSD\nNFS / retained Longhorn"
  }

  namespaces: Workload Namespaces {
    style.fill: "#e8f5e9"
    style.stroke: "#2e7d32"

    default: {
      label: "default"
      shape: rectangle
      style.fill: "#c8e6c9"
    }

    home: {
      label: "home-automation\nHome Assistant • MariaDB\nMQTT • Zigbee2MQTT"
      shape: rectangle
      style.fill: "#c8e6c9"
    }

    media: {
      label: "plex • immich • rdt-client\nmeditation-player • stremio"
      shape: rectangle
      style.fill: "#c8e6c9"
    }

    network_ns: {
      label: "network\nUniFi + MongoDB"
      shape: rectangle
      style.fill: "#c8e6c9"
    }

    external_ns: {
      label: "External-source namespaces\nMovie Night • Splitbot"
      shape: rectangle
      style.fill: "#c8e6c9"
    }
  }

  hardware: Hardware-bound Workloads {
    style.fill: "#ffebee"
    style.stroke: "#c62828"

    zigbee: "Zigbee2MQTT\n/dev/ttyUSB0"
    plex: "Plex\n/dev/dri"
    database: "MariaDB + MongoDB\nnode-role=database"
    trading: "Trading Dashboard\nhostPath data"
  }
}

internet: Internet and LAN Clients {
  shape: cloud
  style.fill: "#e1f5fe"
  style.stroke: "#0277bd"
}

git -> flux.bootstrap: watched source
flux.workloads -> cluster.namespaces: reconciles
external -> flux.workloads: additional sources
internet -> cluster.platform.ingress: HTTPS
cluster.platform.ingress -> cluster.namespaces: routes by hostname
cluster.platform.network -> cluster.namespaces: direct services
cluster.platform.storage -> cluster.namespaces: persistent volumes
cluster.platform.secrets -> cluster.namespaces: decrypted in cluster
cluster.namespaces.home -> cluster.hardware.zigbee
cluster.namespaces.media -> cluster.hardware.plex
cluster.namespaces.home -> cluster.hardware.database
cluster.namespaces.default -> cluster.hardware.trading

note: "Diagram reflects repository-declared desired state.\nVerify live topology with Flux and kubectl." {
  shape: text
  style.italic: true
  style.font-size: 12
}
